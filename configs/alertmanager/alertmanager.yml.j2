route:
  receiver: 'email'

receivers:
- name: 'email'
  email_configs:
  - to: "{{ smtp_to }}"
    from: "{{ smtp_from }}"
    smarthost: "{{ smtp_host }}:{{ smtp_port }}"
    auth_username: "{{ smtp_user }}"
    auth_password: "{{ smtp_password }}"
    auth_identity: "{{ smtp_user }}"
    require_tls: {{ smtp_tls | default('true') }}